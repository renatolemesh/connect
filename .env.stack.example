# Variaveis que docker-compose.stack.yml espera. Copie para .env na pasta da
# stack e preencha. O .env e gitignored: senhas nao entram no repositorio.

# --- identidade da stack -------------------------------------------------
# Prefixo dos containers: <STACK_PREFIX>-rails, -sidekiq, -redis.
# eletrofast=chatwoot | xpertion=xpertion-chatwoot | teste=test-chatwoot
STACK_PREFIX=
APP_IMAGE=xpertion-connect:4.17.1-rc3

# --- rede ----------------------------------------------------------------
# A porta chega no Puma pela env PORT (config/puma.rb), nao pelo CMD da imagem.
# eletrofast=3000 | xpertion=3001 | teste=3002
APP_PORT=
# 127.0.0.1 publica so no loopback. O nginx fala com o container pela
# shared-net, entao 0.0.0.0 so expoe o Puma a sondagem TLS da internet.
APP_BIND=127.0.0.1
# eletrofast=6382 | xpertion=6380 | teste=6384
REDIS_PORT=
REDIS_PASSWORD=

# --- banco (pg-central) --------------------------------------------------
POSTGRES_HOST=pg-central
POSTGRES_PORT=5432
POSTGRES_USERNAME=
POSTGRES_APP_PASSWORD=
POSTGRES_DATABASE=

# --- aplicacao -----------------------------------------------------------
SECRET_KEY_BASE=
CHATWOOT_BASE_URL=
FRONTEND_URL=
BRAND_NAME=Connect
DISPLAY_MANIFEST=false
ENABLE_ACCOUNT_SIGNUP=false

# --- limites de memoria (2026-08-29) -------------------------------------
# mem_reservation = memory.low no cgroup v2: protege o container do reclaim
# do kernel antes de paginar para swap. Ajustar por stack.
WEB_MEM_LIMIT=1536m
WEB_MEM_RESERVATION=768m
WEB_MEMSWAP_LIMIT=2048m
WORKER_MEM_LIMIT=1280m
WORKER_MEM_RESERVATION=640m
WORKER_MEMSWAP_LIMIT=1792m
REDIS_MEM_LIMIT=256m
REDIS_MEM_RESERVATION=128m
REDIS_MEMSWAP_LIMIT=256m

# --- MFA (opcional) ------------------------------------------------------
# As tres juntas habilitam o 2FA. Uma vez que exista dado cifrado, trocar ou
# perder estas chaves torna esse dado ilegivel. Gerar com:
#   docker compose run --rm web bundle exec rails db:encryption:init
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
